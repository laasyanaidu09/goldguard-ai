# GoldGuard Environment Configuration

# Server Port
PORT=8000

# Toggle Demo Mode (true bypasses actual GCP/Firebase calls and uses local CSV + mock data)
DEMO_MODE=true

# Google Gemini API Key (obtained from Google AI Studio)
# Required if DEMO_MODE=false
GEMINI_API_KEY=

# Google Cloud Configuration
# Required if DEMO_MODE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
